{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "asiaright/free-ticket-war",
  "type": "project",
  "description": "A SSeason to Bloom free ticket war microsite starter.",
  "keywords": ["laravel", "ticketing", "waiting-room"],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "endroid/qr-code": "^6.0",
    "laravel/framework": "12.70.1",
    "laravel/reverb": "^1.6",
    "laravel/tinker": "^3.0",
    "predis/predis": "^2.3"
  },
  "require-dev": {
    "fakerphp/faker": "^1.23",
    "laravel/pint": "^1.13",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.6",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/",
      "Tests\\": "tests/"
    }
  },
  "autoload-dev": { "psr-4": { "Tests\\": "tests/" } },
  "scripts": {
    "setup": ["composer install", "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"", "@php artisan key:generate", "@php artisan migrate --seed", "npm install", "npm run build"],
    "dev": ["Composer\\Config::disableProcessTimeout", "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve\" \"php artisan queue:work --tries=1\" \"php artisan reverb:start\" \"npm run dev\" --names=server,queue,reverb,vite"],
    "test": ["@php artisan config:clear", "@php artisan test"]
  },
  "extra": { "laravel": { "dont-discover": [] } },
  "config": { "optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "allow-plugins": { "php-http/discovery": true } },
  "minimum-stability": "stable",
  "prefer-stable": true
}
